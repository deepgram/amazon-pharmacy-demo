# Copy to .env and fill in. Never commit the result -- .env is gitignored.
DEEPGRAM_API_KEY=

# --- Phone path (optional; the browser client works without any of it) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The inbound number this demo answers on, E.164. Left empty, the phone path is
# simply off and the browser client hides its call-in panel.
TWILIO_FROM_NUMBER=
# Public base URL, no trailing slash. ngrok locally; set in fly.toml on Fly.
PUBLIC_URL=

# Guards /console, /state and /latency, which show live OTP codes.
# Empty = open, which is fine on localhost and not on a public deployment.
CONSOLE_PASSWORD=

# --- Models (defaults are in server/config.py, the source of truth) ---
LISTEN_MODEL=nova-3-medical_pharma
THINK_MODEL=gpt-4o-mini
VOICE_MODEL=flux-brooke-en

# --- Turn-taking ---
# Nova only: silence before the turn is called. Flux rejects it.
LISTEN_ENDPOINTING_MS=500
# auto = send keyterms for Flux only, which is where they measured as helping.
LISTEN_KEYTERMS=auto

# --- Ops ---
TOOL_LATENCY_MS=0
OTP_SMS=1
HOLD_AFTER_S=2.5
# Seconds of caller silence after the agent finishes before a check-in.
# 15 sits above the "stay quiet 5-10s while reading the code" case. 0 disables.
# SILENCE_AFTER_S=15

# Copy to .env and fill in. Never commit the result -- .env is gitignored.
# Var names match the voice-agent-api demo, so one .env carries across both.
# server/config.py there and agent/config.py here are the two sources of truth.

DEEPGRAM_API_KEY=
# The Voice Agent API path needs no LLM key -- it runs the LLM as a
# Deepgram-managed provider. LiveKit calls the provider itself, so this path
# does. It is the only credential the two paths cannot share.
OPENAI_API_KEY=
# Only for THINK_PROVIDER=anthropic (the claude-haiku-4-5 fallback branch).
ANTHROPIC_API_KEY=

# --- Telephony (optional; `agent.main console` needs none of it) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# The inbound number this worker answers on, E.164. Empty = SIP path not wired.
PHARMACY_LK_NUMBER=

# From your LiveKit Cloud project (cloud.livekit.io)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Models (defaults are in agent/config.py, the source of truth) ---
# Underscore, not hyphen: nova-3-medical-pharma fails to start.
LISTEN_MODEL=nova-3-medical_pharma
THINK_PROVIDER=open_ai
THINK_MODEL=gpt-4o-mini
VOICE_MODEL=flux-brooke-en
THINK_TEMPERATURE=0.4

# --- Turn-taking ---
# Nova only, and a measured floor rather than a guess. Flux rejects it.
LISTEN_ENDPOINTING_MS=500
# Flux only.
EOT_THRESHOLD=0.7
EOT_TIMEOUT_MS=5000
EAGER_EOT_THRESHOLD=0.4
LISTEN_KEYTERMS=auto
# LiveKit's own endpointing, stacked on top of the STT's. No equivalent on the
# Voice Agent API path -- the first knob to reach for if the two disagree on
# turn latency.
ENDPOINTING_MIN_DELAY_S=0.3
ENDPOINTING_MAX_DELAY_S=2.5

# --- Ops ---
TOOL_LATENCY_MS=0
OTP_SMS=1
# Fixed verification code phone callers get. A demo fixture, not a secret:
# nothing is actually sent, and the account behind it is synthetic. Must be six
# digits -- an empty value leaves phone callers with no code to say.
DEMO_OTP=936722
TAGS=pharmacy-demo-livekit
MIP_OPT_OUT=1
